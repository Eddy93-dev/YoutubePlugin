{
  "manifest_version": 3,
  "name": "YouTube Watched Hider",
  "version": "0.24.0",
  "description": "Hide or gray out videos you've already watched on YouTube, and hide Shorts.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Watched Hider",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["popup.html", "icons/icon32.png"], "matches": ["https://www.youtube.com/*"] }
  ],
  "commands": {
    "toggle-watched": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Toggle the watched-video filter"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib.js", "panel.js", "groups.js", "group-feed.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
